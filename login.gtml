<!DOCTYPE html>
<html lang="tg"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Login</title>
<style>body{margin:0;font-family:sans-serif;background:#f0fdf4;display:flex;min-height:100vh;align-items:center;justify-content:center;padding:16px}
.box{background:white;max-width:400px;width:100%;border-radius:16px;padding:22px;box-shadow:0 8px 20px #0001}
h2{color:#16a34a;text-align:center} input{width:100%;padding:12px;border:1px solid #ddd;border-radius:10px}
button{width:100%;background:#16a34a;color:white;border:none;padding:12px;border-radius:10px;margin-top:10px;font-weight:bold}
.hint{background:#f0fdf4;padding:10px;border-radius:10px;font-size:12px;margin-top:10px}
.err{color:red;font-size:13px;display:none;text-align:center;margin-top:8px}
</style></head><body>
<div class="box"><h2>Ворид шудан</h2>
<input id="code" placeholder="1 ё iqtisod">
<div id="err" class="err"></div>
<button onclick="login()">Ворид</button>
<div class="hint">Донишҷу: 1-6000<br>Декан: iqtisod (10000), huquq (10010), filologiya (20010), it (30010), tarikh (40010), tib (50010)<br>Муовин: iqtisod-m1 (10001)</div>
<a href="index.html" style="display:block;text-align:center;margin-top:10px;color:#16a34a">← Асоси</a></div>
<script>
const facs=[{c:'iqtisod',s:1,e:1000,d:10000},{c:'huquq',s:1001,e:2000,d:10010},{c:'filologiya',s:2001,e:3000,d:20010},{c:'it',s:3001,e:4000,d:30010},{c:'tarikh',s:4001,e:5000,d:40010},{c:'tib',s:5001,e:6000,d:50010}];
function login(){
let raw=document.getElementById('code').value.trim().toLowerCase();
let err=document.getElementById('err'); err.style.display='none';
if(!raw){err.textContent='Код нависед';err.style.display='block';return;}
let f=facs.find(x=>x.c===raw); if(f){localStorage.setItem('faculty',f.c);localStorage.setItem('userCode',raw);location.href='dean.html?code='+raw;return;}
let m=raw.match(/^(iqtisod|huquq|filologiya|it|tarikh|tib)-m([1-4])$/);
if(m){localStorage.setItem('faculty',m[1]);localStorage.setItem('userCode',raw);location.href='dean.html?code='+raw;return;}
let n=parseInt(raw,10);
if(!isNaN(n)){
let fd=facs.find(x=>x.d===n||x.d+1===n||x.d+2===n||x.d+3===n||x.d+4===n);
if(fd){localStorage.setItem('faculty',fd.c);localStorage.setItem('userCode',n);location.href='dean.html?code='+n;return;}
if(n>=1&&n<=6000){let ff=facs.find(x=>n>=x.s&&n<=x.e);localStorage.setItem('faculty',ff.c);localStorage.setItem('studentId',n);location.href='dashboard.html?code='+n;return;}
}
err.textContent='Дуруст нест! 1-6000 ё iqtisod';err.style.display='block';
}
</script></body></html>
