<!DOCTYPE html><html lang="tg"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>University Portal V2 Full - 6000</title>
<style>*{margin:0;padding:0;box-sizing:border-box;font-family:Segoe UI,sans-serif}body{background:#eef3f8}header{background:linear-gradient(135deg,#0d47a1,#1976d2);color:#fff;padding:12px 15px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:20}.main{display:flex}.sidebar{width:250px;background:#fff;padding:10px}.menu{padding:11px;border-radius:10px;cursor:pointer;margin:4px 0;font-size:14px}.menu.active,.menu:hover{background:#e3f2fd;color:#0d47a1;font-weight:700}.content{flex:1;padding:15px}.card{background:#fff;border-radius:14px;padding:16px;box-shadow:0 3px 12px rgba(0,0,0,.05);margin-bottom:14px}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:12px}.btn{padding:9px 14px;border:none;border-radius:8px;cursor:pointer;font-weight:700}.btn-p{background:#1976d2;color:#fff}.btn-s{background:#2e7d32;color:#fff}input,select{width:100%;padding:11px;border:1px solid #ddd;border-radius:8px;margin:6px 0}table{width:100%;border-collapse:collapse}th,td{padding:8px;border-bottom:1px solid #eee;font-size:13px}.badge{padding:3px 8px;border-radius:12px;color:#fff;font-size:11px}.b-sahar{background:#0288d1}.b-abet{background:#ef6c00}.b-roy{background:#2e7d32}.b-shart{background:#c62828}.hidden{display:none}.login{height:100vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#0d47a1,#42a5f5);padding:15px}.login-card{background:#fff;padding:22px;border-radius:18px;width:100%;max-width:400px}.tab{padding:8px 12px;cursor:pointer;border-bottom:3px solid transparent}.tab.active{border-color:#1976d2;color:#1976d2;font-weight:800}</style></head><body>
<div id="loginPage" class="login"><div class="login-card"><h2 style="text-align:center;color:#0d47a1">🎓 Портали V2 ПУРРА</h2><p style="text-align:center;font-size:12px;color:#666">6000 донишҷӯ (3000 саҳар + 3000 абет) | 200 омӯзгор | ID+Код | Сурат | Китобхона</p><div style="text-align:center;margin:10px 0"><span id="tabL" class="tab active" onclick="showTab('L')">Ворид</span><span id="tabR" class="tab" onclick="showTab('R')">Код гузоштан</span></div>
<div id="fL"><input id="lid" placeholder="ID: 1-6000, 7001-7200 омӯзгор, 9999 админ" type="number"><input id="lpass" type="password" placeholder="Коди шахсӣ"><button class="btn btn-p" style="width:100%" onclick="doLogin()">Ворид шудан</button><p style="font-size:11px;color:#666;margin-top:6px">Бори аввал: ID + код 4 рақам гузоред - сабт мешавад!</p></div>
<div id="fR" class="hidden"><input id="rid" placeholder="ID 1-6000" type="number"><input id="rname" placeholder="Номи пурра"><select id="rfac"><option value="iqtisod">Иқтисод (Декан Назиров А. А-101)</option><option value="huquq">Ҳуқуқ (Раҳимов Б. Б-205)</option><option value="tib">Тиб (Салимова М. В-302)</option><option value="muhandisi">Муҳандисӣ (Каримов Д. Г-104)</option><option value="zabonho">Забонҳо (Ҳакимова С. Д-201)</option><option value="it">IT (Алиев Ф. Е-303)</option></select><select id="rtype"><option value="sahar">Саҳархон</option><option value="abet">Абетхон</option></select><input id="rp1" type="password" placeholder="Код"><input id="rp2" type="password" placeholder="Такрори код"><button class="btn btn-s" style="width:100%" onclick="doReg()">Сабти код</button></div><div id="msg" style="margin-top:10px;text-align:center;font-size:12px"></div></div></div>
<div id="appPage" class="hidden"><header><div style="font-weight:900">🎓 UNIVERSITY V2 FULL</div><div style="display:flex;align-items:center;gap:8px"><div style="text-align:right"><div id="hname" style="font-weight:700;font-size:13px"></div><div id="hrole" style="font-size:10px"></div></div><div id="hava" style="width:36px;height:36px;background:#fff;color:#0d47a1;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:900;overflow:hidden"></div><button onclick="doLogout()" style="background:rgba(255,255,255,.2);border:none;color:#fff;padding:6px 10px;border-radius:6px">Баромад</button></div></header><div class="main"><div class="sidebar" id="sidebar"></div><div class="content" id="content"></div></div></div>
<script>
const faculties={iqtisod:{name:"Иқтисод",dekan:"Проф. Назиров А.",aud:"А-101",deanId:10000},huquq:{name:"Ҳуқуқ",dekan:"Проф. Раҳимов Б.",aud:"Б-205",deanId:10010},tib:{name:"Тиб",dekan:"Проф. Салимова М.",aud:"В-302",deanId:20010},muhandisi:{name:"Муҳандисӣ",dekan:"Проф. Каримов Д.",aud:"Г-104",deanId:30010},zabonho:{name:"Забонҳо",dekan:"Проф. Ҳакимова С.",aud:"Д-201",deanId:40010},it:{name:"IT",dekan:"Проф. Алиев Ф.",aud:"Е-303",deanId:50010}};
const subjectsList={iqtisod:["Микроиқтисод","Макроиқтисод","Муҳосибот","Маркетинг","Омор"],huquq:["Конститутсия","Ҷиноят","Гражданӣ","Байналмилалӣ","Суд"],tib:["Анатомия","Физиология","Биохимия","Фармакология","Ҷарроҳӣ"],muhandisi:["Математикаи олӣ","Физика","Механика","Материал","Лоиҳа"],zabonho:["Англисӣ","Тоҷикӣ","Русӣ","Адабиёт","Тарҷума"],it:["Програмиронӣ","База","Шабака","AI","Веб"]};
